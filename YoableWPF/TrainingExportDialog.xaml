<Window x:Class="YoableWPF.TrainingExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{DynamicResource TrainingExport_Title}"
        Width="560"
        Height="500"
        MinWidth="480"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource TrainingExport_Title}"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource TrainingExport_Subtitle}"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <!-- Output folder -->
                <TextBlock Text="{DynamicResource TrainingExport_OutputFolder}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputPathBox"
                             Grid.Column="0"
                             Height="30"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             TextChanged="OutputPath_TextChanged"/>
                    <Button Grid.Column="1"
                            Content="{DynamicResource TrainingExport_Browse}"
                            Width="100"
                            Height="30"
                            Margin="8,0,0,0"
                            Click="Browse_Click"/>
                </Grid>

                <!-- Split ratios -->
                <TextBlock Text="{DynamicResource TrainingExport_SplitRatios}"
                           FontWeight="SemiBold"
                           Margin="0,20,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="{DynamicResource TrainingExport_Train}" FontSize="11"/>
                        <xctk:IntegerUpDown x:Name="TrainInput"
                                            Height="30"
                                            Margin="0,4,0,0"
                                            Minimum="0"
                                            Maximum="100"
                                            Increment="5"
                                            Value="80"
                                            ValueChanged="Ratio_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="3,0">
                        <TextBlock Text="{DynamicResource TrainingExport_Val}" FontSize="11"/>
                        <xctk:IntegerUpDown x:Name="ValInput"
                                            Height="30"
                                            Margin="0,4,0,0"
                                            Minimum="0"
                                            Maximum="100"
                                            Increment="5"
                                            Value="20"
                                            ValueChanged="Ratio_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                        <TextBlock Text="{DynamicResource TrainingExport_Test}" FontSize="11"/>
                        <xctk:IntegerUpDown x:Name="TestInput"
                                            Height="30"
                                            Margin="0,4,0,0"
                                            Minimum="0"
                                            Maximum="100"
                                            Increment="5"
                                            Value="0"
                                            ValueChanged="Ratio_ValueChanged"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="SumText"
                           Margin="0,8,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

                <!-- Seed -->
                <TextBlock Text="{DynamicResource TrainingExport_Seed}"
                           FontWeight="SemiBold"
                           Margin="0,20,0,6"/>
                <xctk:IntegerUpDown x:Name="SeedInput"
                                    Height="30"
                                    Width="140"
                                    HorizontalAlignment="Left"
                                    Minimum="0"
                                    Maximum="2147483647"
                                    Increment="1"
                                    Value="0"/>

                <!-- Options -->
                <CheckBox x:Name="BackgroundCheck"
                          Content="{DynamicResource TrainingExport_IncludeBackground}"
                          Margin="0,20,0,0"/>
                <CheckBox x:Name="VerifiedCheck"
                          Content="{DynamicResource TrainingExport_VerifiedOnly}"
                          Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Common_Cancel}"
                        Width="96"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click"/>
                <Button x:Name="OkButton"
                        Content="{DynamicResource Common_OK}"
                        Width="96"
                        IsDefault="True"
                        Click="Confirm_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
