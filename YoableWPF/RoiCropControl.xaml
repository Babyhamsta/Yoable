<UserControl x:Class="YoableWPF.RoiCropControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="720"
             MinHeight="460">
    <Grid Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,1,0"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{DynamicResource Roi_Title}"
                           FontSize="18"
                           FontWeight="SemiBold"/>

                <Border Grid.Row="1"
                        Margin="0,20,0,0"
                        Padding="12,10"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Roi_OutputSize}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Text="640 x 640 px"
                                   Margin="0,3,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock Text="{DynamicResource Roi_Scope}"
                               Margin="0,0,0,6"
                               FontSize="12"/>
                    <ComboBox x:Name="ScopeComboBox" SelectedIndex="0" Padding="6,4">
                        <ComboBoxItem Content="{DynamicResource Roi_AllImages}"/>
                        <ComboBoxItem Content="{DynamicResource Roi_CurrentImage}"/>
                    </ComboBox>
                </StackPanel>

                <Border Grid.Row="3"
                        Margin="0,16,0,0"
                        Padding="10"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Roi_OutputFolder}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Text="roi_images"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="4" Margin="0,18,0,0" VerticalAlignment="Top">
                    <Separator Margin="0,0,0,12"/>
                    <Button x:Name="RemoveSmallImagesButton"
                            Click="RemoveSmallImagesButton_Click"
                            Padding="12,8"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" Margin="0,0,7,0"/>
                            <TextBlock Text="{DynamicResource Roi_RemoveSmall}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="5">
                    <TextBlock x:Name="StatusText"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <ProgressBar x:Name="CropProgressBar"
                                 Height="5"
                                 Margin="0,0,0,10"
                                 Visibility="Collapsed"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ApplyCropButton"
                                Click="ApplyCropButton_Click"
                                Padding="12,8"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A8;" Margin="0,0,7,0"/>
                                <TextBlock Text="{DynamicResource Roi_Apply}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelCropButton"
                                Grid.Column="2"
                                Width="36"
                                Height="34"
                                Padding="0"
                                Click="CancelCropButton_Click"
                                ToolTip="{DynamicResource Common_Cancel}"
                                Visibility="Collapsed">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Roi_Preview}"
                           FontSize="14"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="PreviewFileNameText"
                           Grid.Column="1"
                           MaxWidth="420"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,10,0,0"
                    Background="#FF202020"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Grid x:Name="PreviewHost" SizeChanged="PreviewHost_SizeChanged">
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                    <Canvas x:Name="PreviewOverlay" IsHitTestVisible="False">
                        <Border x:Name="RoiPreviewBorder"
                                BorderBrush="#FFFFC107"
                                BorderThickness="2"
                                Background="#2200BCD4"/>
                    </Canvas>
                    <TextBlock x:Name="NoPreviewText"
                               Text="{DynamicResource Roi_NoPreview}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
