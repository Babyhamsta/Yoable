<UserControl x:Class="YoableWPF.DuplicateImageReviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YoableWPF"
             MinWidth="640"
             MinHeight="420">
    <UserControl.Resources>
        <local:DuplicateThumbnailConverter x:Key="DuplicateThumbnailConverter"/>
    </UserControl.Resources>
    <Grid Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Duplicate_Title}"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="SummaryText"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
                <Button x:Name="ScanButton"
                        Grid.Column="1"
                        Click="ScanButton_Click"
                        Padding="12,7"
                        MinWidth="110">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE72C;"
                                   Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource Duplicate_Scan}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid x:Name="ReviewPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="164"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="GroupProgressText"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Background="#FF202020" CornerRadius="4" ClipToBounds="True">
                                <local:DuplicateLabelPreview x:Name="LeftImage"/>
                            </Border>
                            <TextBlock x:Name="LeftFileNameText"
                                       Grid.Row="1"
                                       Margin="0,10,0,0"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <TextBlock x:Name="LeftDetailsText"
                                       Grid.Row="2"
                                       Margin="0,4,0,10"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="EditLeftButton"
                                        Click="EditLeftButton_Click"
                                        Width="40"
                                        Padding="0"
                                        ToolTip="{DynamicResource Duplicate_OpenEdit}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;"/>
                                </Button>
                                <Button x:Name="KeepLeftButton"
                                        Grid.Column="2"
                                        Click="KeepLeftButton_Click"
                                        Padding="10,8"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76B;" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource Duplicate_KeepLeft}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Background="#FF202020" CornerRadius="4" ClipToBounds="True">
                                <local:DuplicateLabelPreview x:Name="RightImage"/>
                            </Border>
                            <TextBlock x:Name="RightFileNameText"
                                       Grid.Row="1"
                                       Margin="0,10,0,0"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <TextBlock x:Name="RightDetailsText"
                                       Grid.Row="2"
                                       Margin="0,4,0,10"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="EditRightButton"
                                        Click="EditRightButton_Click"
                                        Width="40"
                                        Padding="0"
                                        ToolTip="{DynamicResource Duplicate_OpenEdit}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;"/>
                                </Button>
                                <Button x:Name="KeepRightButton"
                                        Grid.Column="2"
                                        Click="KeepRightButton_Click"
                                        Padding="10,8"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource Duplicate_KeepRight}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Margin="0,12,0,0"
                        Padding="10,8"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Duplicate_AllGroups}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                            <Button x:Name="PreviousGroupButton"
                                    Grid.Column="1"
                                    Width="34"
                                    Height="28"
                                    Margin="0,0,6,0"
                                    Padding="0"
                                    Click="PreviousGroupButton_Click"
                                    ToolTip="{DynamicResource Duplicate_PreviousGroup}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76B;"/>
                            </Button>
                            <Button x:Name="NextGroupButton"
                                    Grid.Column="2"
                                    Width="34"
                                    Height="28"
                                    Padding="0"
                                    Click="NextGroupButton_Click"
                                    ToolTip="{DynamicResource Duplicate_NextGroup}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76C;"/>
                            </Button>
                        </Grid>

                        <ListBox x:Name="DuplicateGroupListBox"
                                 Grid.Row="1"
                                 Margin="0,7,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionMode="Single"
                                 SelectionChanged="DuplicateGroupListBox_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Width" Value="270"/>
                                    <Setter Property="Height" Value="104"/>
                                    <Setter Property="Margin" Value="0,0,7,0"/>
                                    <Setter Property="Padding" Value="7,5"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding HeaderText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                        <Grid Grid.Row="1" Margin="0,4,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#FF202020" ClipToBounds="True" CornerRadius="2">
                                                <Image Source="{Binding LeftFullPath, Converter={StaticResource DuplicateThumbnailConverter}, IsAsync=True}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <Border Grid.Column="2" Background="#FF202020" ClipToBounds="True" CornerRadius="2">
                                                <Image Source="{Binding RightFullPath, Converter={StaticResource DuplicateThumbnailConverter}, IsAsync=True}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding LeftCaption}"
                                                       FontSize="9"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding LeftToolTip}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding RightCaption}"
                                                       FontSize="9"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding RightToolTip}"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel x:Name="EmptyPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="&#xEB9F;"
                           FontSize="40"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock x:Name="EmptyText"
                           Text="{DynamicResource Duplicate_NoScan}"
                           Margin="0,12,0,0"
                           FontSize="14"
                           HorizontalAlignment="Center"/>
                <ProgressBar x:Name="ScanProgressBar"
                             Width="280"
                             Height="4"
                             Margin="0,14,0,0"
                             Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
