<Window x:Class="YoableWPF.ModelClassMappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{DynamicResource Mapping_Title}"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="500"
        MinWidth="700">
    
    <Window.Resources>
        
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Mapping_Title}" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="InfoText"
                               Text="{DynamicResource Mapping_Description}"
                               Foreground="Gray"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="LoadClassFileButton"
                        Content="{DynamicResource Mapping_LoadClassFile}"
                        Click="LoadClassFileButton_Click"
                        Padding="12,6"
                        Margin="8,0,0,0"
                        VerticalAlignment="Top"/>
            </Grid>
        </StackPanel>

        <!-- Mapping List -->
        <Border Grid.Row="1" 
                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                CornerRadius="6"
                Padding="16"
                Margin="0,0,0,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MappingList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="4"
                                    Padding="12"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Model Class Info -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                                        <Border Width="4" 
                                                Height="20" 
                                                Background="{StaticResource GlyphPurpleBrush}"
                                                CornerRadius="2"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ModelClassName}" 
                                                       FontWeight="SemiBold"
                                                       FontSize="13"/>
                                            <TextBlock Text="{Binding ModelIdDisplayText}"
                                                       FontSize="11"
                                                       Foreground="Gray"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Arrow -->
                                    <TextBlock Grid.Column="1" 
                                               Text="→" 
                                               FontSize="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource GlyphPurpleBrush}"/>

                                    <!-- Allowed project classes (tick none to exclude the class) -->
                                    <StackPanel Grid.Column="2"
                                                MinWidth="240"
                                                Margin="16,0,0,0">
                                        <ItemsControl ItemsSource="{Binding ProjectClasses}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Margin="0,2,14,2"
                                                              VerticalContentAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="4"
                                                                    Height="16"
                                                                    Background="{Binding ColorBrush}"
                                                                    CornerRadius="2"
                                                                    Margin="0,0,6,0"
                                                                    VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DisplayText}"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding SelectionSummary}"
                                                   FontSize="11"
                                                   Foreground="Gray"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="{DynamicResource Common_OK}" 
                    Click="OKButton_Click"
                    Style="{StaticResource ModernButton}"
                    MinWidth="100"
                    Margin="0,0,8,0"
                    IsDefault="True"/>
            <Button Content="{DynamicResource Common_Cancel}" 
                    Click="CancelButton_Click"
                    MinWidth="100"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

