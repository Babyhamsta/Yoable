<Window
    x:Class="YoableWPF.YoutubeDownloadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    ui:WindowHelper.UseModernWindowStyle="True"
    Title="YouTube Video Download"
    Height="480"
    Width="550"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize">

    <Window.Resources>
        <!-- Accent color for buttons (uses system accent) -->

        <!-- Modern Button Style -->

        <!-- Secondary Button Style -->

        <!-- Setting Card Style -->

        <!-- Label Style -->

        <!-- Help Text Style -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Padding="24,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock FontFamily="Segoe MDL2 Assets" 
                               Text="&#xE714;" 
                               FontSize="24"
                               Foreground="{StaticResource DangerBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <TextBlock Text="YouTube Video Download" 
                               FontSize="20" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Download and extract frames from YouTube videos for labeling"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Padding="24,20">
            <StackPanel>
                <!-- URL Input Card -->
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="YouTube URL" Style="{StaticResource SettingLabel}"/>
                        <TextBox x:Name="YoutubeUrlTextBox" 
                                 FontSize="13"
                                 Padding="8"/>
                        <TextBlock Text="Enter the full YouTube video URL (e.g., https://youtube.com/watch?v=...)"
                                   Style="{StaticResource HelpText}"/>
                    </StackPanel>
                </Border>

                <!-- FPS Setting Card -->
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Frames Per Second to Capture" Style="{StaticResource SettingLabel}"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="FPSSlider" 
                                    Minimum="1" 
                                    Maximum="30"
                                    Value="1"
                                    TickFrequency="1"
                                    TickPlacement="BottomRight"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding Value, ElementName=FPSSlider, StringFormat={}{0:0} fps}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Grid>
                        <TextBlock Text="Number of images to extract per second of video. Higher values create more images."
                                   Style="{StaticResource HelpText}"/>
                    </StackPanel>
                </Border>

                <!-- Frame Size Card -->
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Frame Size" Style="{StaticResource SettingLabel}"/>
                        <ComboBox x:Name="FrameSizeComboBox" 
                                  SelectedIndex="3" 
                                  FontSize="13"
                                  Padding="8">
                            <ComboBoxItem Content="256x256"/>
                            <ComboBoxItem Content="416x416"/>
                            <ComboBoxItem Content="512x512"/>
                            <ComboBoxItem Content="640x640"/>
                            <ComboBoxItem Content="1024x1024"/>
                        </ComboBox>
                        <TextBlock Text="Resolution for extracted frames. Use 640x640 for standard YOLO training."
                                   Style="{StaticResource HelpText}"/>
                    </StackPanel>
                </Border>

                <!-- Info Card -->
                <Border Background="{StaticResource InfoSubtleBrush}"
                        CornerRadius="6"
                        Padding="16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE946;"
                                   FontSize="16"
                                   Foreground="{StaticResource InfoBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="Frames will be extracted, resized, and imported automatically into the image list."
                                   Foreground="{StaticResource InfoDeepBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer with Buttons -->
        <Border Grid.Row="2"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DownloadButton" 
                        Content="Download" 
                        Click="DownloadButton_Click"
                        Style="{StaticResource ModernButton}"
                        MinWidth="100"
                        Margin="0,0,8,0"/>
                <Button x:Name="CancelButton" 
                        Content="Cancel" 
                        Click="CancelButton_Click"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="80"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>