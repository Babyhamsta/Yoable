<Window x:Class="YoableWPF.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{DynamicResource Startup_Title}"
        Width="900"
        Height="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="800"
        MinHeight="650">

    <Window.Resources>
        <!-- Recent project card: theme-aware hover -->
        <Style x:Key="ProjectCard" TargetType="Border" BasedOn="{StaticResource ModernCard}">
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Text link -->
        <Style x:Key="TextLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Text"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeader}" Padding="40,28">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE8B7;"
                               FontSize="44"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Yoable"
                                   FontSize="30"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource Startup_Subtitle}"
                                   FontSize="14"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="VersionText"
                           Text="Version"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="40,20">
            <StackPanel>
                <!-- Recent Projects Section -->
                <StackPanel x:Name="RecentProjectsPanel">
                    <TextBlock Text="{DynamicResource Startup_RecentProjects}"
                               Style="{StaticResource SectionHeader}"/>

                    <!-- Recent Projects List -->
                    <ItemsControl x:Name="RecentProjectsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ProjectCard}"
                                        MouseLeftButtonDown="ProjectCard_Click"
                                        Tag="{Binding ProjectPath}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Project Icon -->
                                        <Border Grid.Column="0"
                                                Background="{StaticResource InfoSubtleBrush}"
                                                CornerRadius="8"
                                                Width="48"
                                                Height="48"
                                                Margin="0,0,16,0">
                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       Text="&#xE8B7;"
                                                       FontSize="24"
                                                       Foreground="{StaticResource InfoBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Project Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProjectName}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ProjectPath}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding LastOpenedText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}"
                                                    Width="32" Height="32"
                                                    ToolTip="{DynamicResource Startup_OpenFolderTooltip}"
                                                    Tag="{Binding ProjectPath}"
                                                    Click="OpenProjectFolder_Click">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE838;"
                                                           FontSize="15"
                                                           Foreground="{StaticResource InfoBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Width="32" Height="32"
                                                    Margin="4,0,0,0"
                                                    ToolTip="{DynamicResource Startup_DeleteTooltip}"
                                                    Tag="{Binding ProjectPath}"
                                                    Click="DeleteProject_Click">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE74D;"
                                                           FontSize="15"
                                                           Foreground="{StaticResource DangerBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <Border x:Name="EmptyStatePanel"
                            Background="Transparent"
                            BorderThickness="2"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            CornerRadius="8"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="32">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8B7;"
                                       FontSize="48"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       HorizontalAlignment="Center"
                                       Opacity="0.5"
                                       Margin="0,0,0,16"/>
                            <TextBlock Text="{DynamicResource Startup_NoRecent}"
                                       FontSize="16"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{DynamicResource Startup_NoRecentHint}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Opacity="0.7"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Action Buttons -->
                <Grid Margin="0,32,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="NewProjectButton"
                            Style="{StaticResource ModernButton}"
                            Click="NewProject_Click"
                            Padding="24,14"
                            FontSize="15"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE710;"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="{DynamicResource Startup_NewProject}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            x:Name="OpenProjectButton"
                            Style="{StaticResource SecondaryButton}"
                            Click="OpenProject_Click"
                            Padding="24,14"
                            FontSize="15"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8E5;"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="{DynamicResource Startup_OpenProject}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooter}" Padding="40,14">
            <Grid>
                <Button x:Name="ContinueWithoutProjectButton"
                        Content="{DynamicResource Startup_ContinueWithout}"
                        Click="ContinueWithoutProject_Click"
                        Style="{StaticResource TextLink}"
                        HorizontalAlignment="Left"/>
            </Grid>
        </Border>
    </Grid>
</Window>
